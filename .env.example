# =============================================================================
# GardenBuddy Environment Configuration Template
# NOTE: Do NOT place real secrets in this file or commit production credentials.
# Configure sensitive keys securely in Render's Environment Variables dashboard.
# =============================================================================

# Application Settings
APP_NAME=GardenBuddy
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=False
PORT=10000
HOST=0.0.0.0
ALLOWED_ORIGINS=*

# Database Configuration (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# On Render, this is automatically wired from the managed database via DATABASE_URL
DATABASE_URL=postgresql://gardenbuddy_user:password@localhost:5432/gardenbuddy

# External API Integrations (Optional / Fallback-enabled)
# 1. Weather API (OpenWeatherMap or compatible service)
WEATHER_API_KEY=
# 2. Backboard.io Persistent AI Memory
BACKBOARD_API_KEY=
BACKBOARD_API_URL=https://api.backboard.io/v1
# 3. Thinking Machines AI Reasoning Engine
THINKING_MACHINES_API_KEY=
THINKING_MACHINES_API_URL=https://api.thinkingmachines.ai/v1
THINKING_MACHINES_MODEL=thinking-machines-default
# 4. DevRelay MCP Gateway
DEVRELAY_GATEWAY_URL=http://localhost:8080
